# ──────────────────────────────────────────────────────────────────────────────
# Crazy Mess Meet · Umgebungsvariablen
# Kopiere diese Datei als ".env.local" und fülle alle Werte aus.
# NIEMALS die .env.local in Git einchecken!
# ──────────────────────────────────────────────────────────────────────────────

# Firebase Web App Config
# → https://console.firebase.google.com → Dein Projekt → Projekteinstellungen → Web-App
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Spotify Web API (optional – für automatische Metadaten bei Spotify-Links)
# → https://developer.spotify.com/dashboard → App erstellen → Client Credentials
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id
VITE_SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
