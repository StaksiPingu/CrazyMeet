rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the user authenticated?
    function isAuth() {
      return request.auth != null;
    }

    // Helper: is the user an admin?
    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: is the requesting user the owner?
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Users: read by any authenticated user, write only own document
    match /users/{uid} {
      allow read: if isAuth();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // Messages: read/create by any auth user, delete own or admin
    match /messages/{msgId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.senderId == request.auth.uid;
      allow delete: if isAuth() && (resource.data.senderId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // Events: read/create by auth users, delete own or admin
    match /events/{eventId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isAuth() && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow update: if isAuth() && (
        isAdmin() ||
        resource.data.createdBy == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendance'])
      );
    }

    // Songs: read by auth, create by auth, delete own or admin
    match /songs/{songId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.addedBy == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAuth() && (resource.data.addedBy == request.auth.uid || isAdmin());
    }

    // Votes: read/create by auth, delete own or admin, update votes/closed by auth
    match /votes/{voteId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isAuth() && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow update: if isAuth() && (
        isAdmin() ||
        resource.data.createdBy == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
      );
    }

    // Playlists: read/create by auth, update/delete own or admin
    match /playlists/{playlistId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuth() && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow delete: if isAuth() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // Config (links etc.): read by auth, write by admin
    match /config/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
  }
}
